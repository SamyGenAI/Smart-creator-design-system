{
  "order": ["newsletter", "youtube", "linkedin", "x"],
  "manifest": "waterfall.json",
  "brief": {
    "channel": "newsletter",
    "file": "brief.md"
  },
  "platforms": {
    "newsletter": {
      "writer": "newsletter-writer",
      "assets": [
        {
          "id": "issue",
          "label": "Newsletter issue",
          "required": true,
          "files": ["issue.md"],
          "acceptPrimaryMarkdown": true,
          "handsTo": null
        },
        {
          "id": "thumbnail",
          "label": "Email thumbnail",
          "required": false,
          "files": ["Assets/thumbnail.png"],
          "acceptPrimaryMarkdown": false,
          "handsTo": {
            "skill": "newsletter-thumbnail-designer",
            "canvas": "420x300",
            "render": "pnpm dev, then Export → Download PNG. With the server up: GET /api/export/png?mode=<modeKey>. Do not call render.py."
          }
        }
      ]
    },
    "youtube": {
      "writer": "youtube-writer",
      "assets": [
        {
          "id": "script",
          "label": "YouTube script",
          "required": true,
          "files": ["script.md", "Script.md"],
          "acceptPrimaryMarkdown": true,
          "handsTo": null
        },
        {
          "id": "titles",
          "label": "YouTube titles",
          "required": true,
          "files": ["titles.md"],
          "acceptPrimaryMarkdown": false,
          "handsTo": null
        },
        {
          "id": "description",
          "label": "YouTube description",
          "required": true,
          "files": ["description.md"],
          "acceptPrimaryMarkdown": false,
          "handsTo": null
        },
        {
          "id": "thumbnail",
          "label": "YouTube thumbnail concept",
          "required": false,
          "files": ["Assets/thumbnail-concept.md"],
          "acceptPrimaryMarkdown": false,
          "handsTo": {
            "skill": "youtube-thumbnail",
            "canvas": "1280x720 concept only. This app has no YouTube thumbnail canvas yet.",
            "render": "Write the concept into Assets/thumbnail-concept.md. Do not use newsletter-thumbnail-designer."
          }
        }
      ]
    },
    "linkedin": {
      "writer": "linkedin-writer",
      "assets": [
        {
          "id": "post",
          "label": "LinkedIn post",
          "required": true,
          "files": ["post.md"],
          "acceptPrimaryMarkdown": true,
          "handsTo": {
            "skill": "infographics-designer",
            "canvas": "1080x1350, only when the post needs a graphic",
            "render": "graphics-designer chooses, infographics-designer builds. pnpm dev, Export → Download PNG, or GET /api/export/png?mode=<modeKey>. Save Assets/infographic.png. Do not call render.py."
          }
        },
        {
          "id": "hooks",
          "label": "LinkedIn hooks",
          "required": false,
          "files": ["hooks.md"],
          "acceptPrimaryMarkdown": false,
          "satisfiedByAssets": ["post"],
          "handsTo": null
        },
        {
          "id": "carousel",
          "label": "LinkedIn carousel",
          "required": false,
          "files": ["carousel.md"],
          "acceptPrimaryMarkdown": false,
          "handsTo": {
            "skill": "carousel-designer",
            "canvas": "1080x1350 per slide",
            "render": "pnpm dev, Export → Download PDF, or GET /api/export/pdf?mode=<modeKey>. Save Assets/carousel.pdf. Do not call render.py."
          }
        }
      ]
    },
    "x": {
      "writer": "x-writer",
      "assets": [
        {
          "id": "article",
          "label": "X Article",
          "required": true,
          "files": ["article.md"],
          "acceptPrimaryMarkdown": true,
          "handsTo": {
            "skill": "graphics-designer",
            "canvas": "Cover and inline figures",
            "render": "graphics-designer routes each figure to infographics-designer, carousel-designer, or flowchart. Save the cover and numbered inline images in Assets/. Do not call render.py."
          }
        },
        {
          "id": "thread",
          "label": "X thread",
          "required": false,
          "files": ["thread.md"],
          "acceptPrimaryMarkdown": false,
          "handsTo": null
        },
        {
          "id": "post",
          "label": "X post",
          "required": false,
          "files": ["post.md"],
          "acceptPrimaryMarkdown": false,
          "handsTo": null
        }
      ]
    }
  }
}
